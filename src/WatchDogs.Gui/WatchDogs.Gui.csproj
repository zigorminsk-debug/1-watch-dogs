<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WatchDogs.Gui</RootNamespace>
    <AssemblyName>WatchDogs</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Watch Dogs — мониторинг службы 1С</AssemblyTitle>
    <Description>GUI для настройки и управления мониторингом службы 1С-сервера</Description>
    <Company>csl.by</Company>
    <Product>Watch Dogs</Product>
    <Copyright>© csl.by · +375 29 337-14-12</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\..\assets\watchdogs-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\watchdogs-icon.png" LogicalName="WatchDogs.Gui.watchdogs-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WatchDogs.Core\WatchDogs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
